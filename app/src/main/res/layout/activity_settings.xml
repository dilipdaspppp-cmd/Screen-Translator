<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/api_keys_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etKey1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_key_1"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etKey2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_key_2"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etKey3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_key_3"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etKey4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_key_4"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etKey5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_key_5"
            android:inputType="text"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/models_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cbAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_model"
            android:textStyle="bold"
            android:checked="true"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_help"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cbModel1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/model_1"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbModel2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/model_2"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbModel3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/model_3"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbModel4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/model_4"
            android:checked="false"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbModel5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/model_5"
            android:checked="false"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clear_history"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textIsSelectable="true"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>
